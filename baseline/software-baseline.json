  "asr": {
    "recommended": [
      { "id": "d4f940ab-401b-4efc-aadc-ad5f3c50688a", "name": "Block Office apps from creating child processes" },
      { "id": "c1db55ab-c21a-4637-bb3f-a12568109d35", "name": "Block credential stealing from lsass.exe" },
      { "id": "be9ba2d9-53ea-4cdc-84e5-9b1eeee46550", "name": "Block executable content from email" }
    ]
