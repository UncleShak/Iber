{#- s4.10 full report, laid out and worded per Frank's report design spec (C7).
    Reads only the report model (s2.3 row 9): no status is computed, nothing
    is re-ranked or sorted. Self-contained: inline CSS, no script, no external
    fonts, images or links.
    ASCII source: non-ASCII characters come from html.py or HTML entities. -#}
{% macro status_badge(status, size="") -%}
{% set b = badge(status) %}
<span class="badge badge-{{ b.tone }}{% if status == 'failed' %} badge-failed{% endif %}{% if size %} badge-{{ size }}{% endif %}"><span class="sym" aria-hidden="true">{{ b.symbol }}</span> {{ b.word }}</span>
{%- endmacro %}
{% macro fix_block(f, n=none, top_rank=none) -%}
{# Same layout everywhere: rank, title, why, steps, then effort and admin. #}
<div class="fix fix-{{ f.severity }}{% if n %} fix-ranked{% endif %}"{% if not n %} id="fix-{{ f.id }}"{% endif %}>
  {% if n %}<span class="rank" aria-hidden="true">{{ n }}</span>{% endif %}
  <div class="fix-body">
    <h3>{% if n %}<span class="sr">Fix {{ n }}: </span>{% endif %}{{ f.title }} {{ status_badge(f.severity) }}{% if top_rank %} <span class="tag">Top fix {{ top_rank }}</span>{% endif %}</h3>
    <p>{{ f.why }}</p>
    <p class="steps-label">Steps</p>
    <ol>
      {% for step in f.steps %}
      <li>{{ step }}</li>
      {% endfor %}
    </ol>
    <p class="meta">~{{ f.effort_minutes }} min{% if f.needs_admin %} &middot; Needs admin{% endif %}</p>
  </div>
</div>
{%- endmacro %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ product }} &mdash; Cyber Health Check &mdash; {{ report.generated_at | human_date }}</title>
<style>
:root {
  --red: {{ rag["red"] }};   --red-bg: {{ rag["red-bg"] }};
  --amber: {{ rag["amber"] }}; --amber-bg: {{ rag["amber-bg"] }};
  --green: {{ rag["green"] }}; --green-bg: {{ rag["green-bg"] }};
  --grey: {{ rag["grey"] }};  --grey-bg: {{ rag["grey-bg"] }};
  --ink: #1a1a1a;   --muted: #667085; --line: #e4e7ec;
}
* { box-sizing: border-box; }
html { background: #ffffff; }
body {
  margin: 0 auto;
  max-width: 860px;
  padding: 32px 24px 48px;
  font-family: "Segoe UI", system-ui, Arial, sans-serif;
  font-size: 16px;
  line-height: 1.5;
  color: var(--ink);
  background: #ffffff;
}
h1, h2, h3 { line-height: 1.25; margin: 0; }
h1 { font-size: 24px; font-weight: 400; }
h1 strong { font-weight: 700; }
h2 { font-size: 21px; }
h3 { font-size: 17px; }
p { margin: 0 0 8px; }
a { color: inherit; }
.muted, .meta { color: var(--muted); }
.meta { font-size: 14px; margin: 0; }
.sr {
  position: absolute; width: 1px; height: 1px; overflow: hidden;
  clip: rect(0 0 0 0); white-space: nowrap;
}

.badge {
  display: inline-block;
  padding: 2px 10px;
  border: 1.5px solid currentColor;
  border-radius: 999px;
  font-size: 14px;
  font-weight: 600;
  white-space: nowrap;
  vertical-align: middle;
}
.badge-lg { font-size: 20px; padding: 6px 16px; }
.badge-red { color: var(--red); background: var(--red-bg); }
.badge-amber { color: var(--amber); background: var(--amber-bg); }
.badge-green { color: var(--green); background: var(--green-bg); }
.badge-grey { color: var(--grey); background: var(--grey-bg); }
.badge-failed { border-style: dashed; }
.tag {
  display: inline-block; padding: 1px 8px; border: 1px solid var(--line); border-radius: 4px;
  font-size: 13px; font-weight: 600; color: var(--muted); vertical-align: middle;
}

header { padding-bottom: 20px; border-bottom: 2px solid var(--ink); }
header h1 { margin-bottom: 14px; }
header .badge-lg { margin-bottom: 12px; }
.summary { font-size: 20px; }
.checked { font-size: 14px; }

section { margin-top: 32px; }
section > h2 { margin-bottom: 12px; }

.fix {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0 12px;
  margin-top: 12px;
  padding: 12px 14px;
  border-left: 4px solid var(--line);
  break-inside: avoid;
  page-break-inside: avoid;
}
.fix-ranked { grid-template-columns: 36px 1fr; }
.fix-red { border-left-color: var(--red); }
.fix-amber { border-left-color: var(--amber); }
.rank { font-size: 26px; font-weight: 700; line-height: 1.1; }
.fix h3 { margin-bottom: 6px; }
.steps-label { font-weight: 600; margin: 4px 0 2px; }
.fix ol { margin: 0 0 6px; padding-left: 22px; }

.strip { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
@media (max-width: 760px) { .strip { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 480px) { .strip { grid-template-columns: repeat(2, 1fr); } }
.tile {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 8px;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 8px;
  text-decoration: none;
}
.tile-title { font-weight: 600; }
.tile .badge { align-self: flex-start; }

.category { padding-top: 20px; border-top: 1px solid var(--line); break-inside: avoid; page-break-inside: avoid; }
.category-head { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-bottom: 8px; }

table.evidence { width: 100%; border-collapse: collapse; margin: 12px 0 4px; font-size: 15px; }
.evidence th, .evidence td { text-align: left; vertical-align: top; padding: 7px 8px; border-bottom: 1px solid var(--line); }
.evidence th { font-size: 14px; color: var(--muted); }
.evidence td:first-child { width: 38%; }
.evidence td.state { width: 80px; font-size: 18px; line-height: 1.2; font-weight: 600; }
.state-red { color: var(--red); }
.state-amber { color: var(--amber); }
.state-green { color: var(--green); }
.state-grey { color: var(--grey); }
td.grey { color: var(--grey); font-style: italic; }

footer { margin-top: 40px; padding-top: 16px; border-top: 2px solid var(--ink); font-size: 14px; }
footer p { margin-bottom: 4px; }
footer .versions { font-size: 13px; color: var(--muted); }

@media print {
  @page { size: A4; margin: 15mm; }
  body { max-width: none; padding: 0; font-size: 11pt; }
  /* Readable without backgrounds: badges keep their border, symbol and word. */
  .badge { background: none !important; }
  section { margin-top: 18px; }
  .category, .fix, header { break-inside: avoid; page-break-inside: avoid; }
  h2, h3 { break-after: avoid; page-break-after: avoid; }
}
</style>
</head>
<body>

<header>
  <h1><strong>{{ product }}</strong> Cyber Health Check</h1>
  {{ status_badge(report.overall, "lg") }}
  <p class="summary">{{ report.summary }}</p>
  <p class="muted checked">Checked on {{ report.generated_at | human_date }}{% if org %} &middot; Licensed to {{ org }}{% endif %}</p>
  {% if not report.scan.is_admin %}
  <p class="muted checked">Scanned without admin rights, so some checks were skipped.</p>
  {% endif %}
</header>

<section id="actions">
  <h2>{{ top_fixes_heading(top_fixes | length) if top_fixes else top_fixes_heading(3) }}</h2>
  {% for fix_id in top_fixes %}
  {{ fix_block(fixes[fix_id], n=loop.index) }}
  {% else %}
  <p>Nothing urgent. Re-check monthly.</p>
  {% endfor %}
</section>

<section id="overview">
  <h2>The 5 checks at a glance</h2>
  <nav class="strip">
    {% for c in report.categories %}
    <a class="tile" href="#{{ c.id }}">
      <span class="tile-title">{{ c.title }}</span>
      {{ status_badge(c.status) }}
    </a>
    {% endfor %}
  </nav>
</section>

{% for c in report.categories %}
<section class="category" id="{{ c.id }}">
  <div class="category-head">
    <h2>{{ c.title }}</h2>
    {{ status_badge(c.status) }}
  </div>
  <p>{{ c.explanation }}</p>
  {% if c.status == "unavailable" and not report.scan.is_admin %}
  <p class="muted">Run Antigravity as administrator for a full check.</p>
  {% endif %}
  {% if c.evidence %}
  <table class="evidence">
    <thead><tr><th scope="col">What we looked at</th><th scope="col">What we found</th><th scope="col">Status</th></tr></thead>
    <tbody>
      {% for row in c.evidence %}
      {% set st = row.status | default(none) %}
      <tr>
        <td>{{ row.label }}</td>
        <td{% if st in ("unavailable", "failed") %} class="grey"{% endif %}>{{ row | evidence_value }}</td>
        {% if st %}
        {% set b = badge(st) %}
        <td class="state state-{{ b.tone }}"><span aria-hidden="true">{{ b.symbol }}</span><span class="sr"> {{ b.word }}</span></td>
        {% else %}
        <td class="state"></td>
        {% endif %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
  {% for fix_id in c.fix_ids %}
  {{ fix_block(fixes[fix_id], top_rank=rank.get(fix_id)) }}
  {% else %}
  <p class="muted">Nothing to fix here.</p>
  {% endfor %}
</section>
{% endfor %}

<footer>
  <p>Generated locally on this PC. Nothing was uploaded.</p>
  <p>This is a guidance check, not a full security audit.</p>
  <p class="versions">Engine {{ report.engine_version }} &middot; Baseline {{ report.baseline_version }} &middot; {{ report.scan.os_caption }}{% if evidence_id %} &middot; Evidence ID {{ evidence_id }}{% endif %}</p>
</footer>

</body>
</html>
