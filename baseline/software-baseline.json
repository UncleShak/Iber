      "min_safe_version": "8.0.4710",
      "severity": "high",
      "eol": false,
      "eol_note": null,
      "update_hint": "Open Configure Java from the Start menu, go to the Update tab, and click Update Now; uninstall Java if nothing on this PC needs it.",
