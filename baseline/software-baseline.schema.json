{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antigravity.local/schema/software-baseline.schema.json",
  "title": "Antigravity software baseline (manual s2.8)",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseline_version", "checked_on", "os", "asr", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "baseline_version": { "$ref": "#/$defs/date" },
    "checked_on": { "$ref": "#/$defs/date" },
    "os": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_supported_build", "win10_eos_date"],
      "properties": {
        "min_supported_build": {
          "type": "object",
          "additionalProperties": false,
          "required": ["win11"],
          "properties": {
            "win11": { "type": "string", "pattern": "^[0-9]{5}$" }
          }
        },
        "win10_eos_date": { "$ref": "#/$defs/date" }
      }
    },
    "asr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended"],
      "properties": {
        "recommended": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "name": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "display_name", "match", "min_safe_version",
        "severity", "eol", "update_hint", "source_url"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "display_name": { "type": "string", "minLength": 1 },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name_regex"],
          "properties": {
            "name_regex": { "type": "string", "pattern": "^\\^.*\\$$" },
            "publisher_regex": { "type": "string", "pattern": "^\\^" }
          }
        },
        "min_safe_version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" },
        "severity": { "enum": ["high", "medium"] },
        "eol": { "type": "boolean" },
        "eol_note": { "type": ["string", "null"] },
        "update_hint": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "pattern": "^https://" }
      }
    }
  }
}
