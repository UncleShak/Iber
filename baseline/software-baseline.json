  "entries": [
    {
      "id": "chrome",
      "display_name": "Google Chrome",
      "match": { "name_regex": "^Google Chrome$", "publisher_regex": "^Google" },
      "min_safe_version": "142.0.7444.175",
      "severity": "high",
      "eol": false,
      "eol_note": null,
      "update_hint": "Open Chrome, go to Settings > About Chrome, let it update, then click Relaunch.",
      "source_url": "https://chromereleases.googleblog.com/"
    },
    {
      "id": "edge",
      "display_name": "Microsoft Edge",
      "match": { "name_regex": "^Microsoft Edge$", "publisher_regex": "^Microsoft" },
      "min_safe_version": "142.0.3595.90",
      "severity": "high",
      "eol": false,
      "eol_note": null,
      "update_hint": "Open Edge, go to Settings > About Microsoft Edge, let it update, then click Restart.",
      "source_url": "https://learn.microsoft.com/en-us/deployedge/microsoft-edge-relnotes-security"
    },
    {
      "id": "firefox",
      "display_name": "Mozilla Firefox",
      "match": {
        "name_regex": "^Mozilla Firefox( [0-9][0-9.]*)?( \\((x64|x86|arm64)[^)]*\\))?$",
        "publisher_regex": "^Mozilla"
      },
      "min_safe_version": "145.0",
      "severity": "high",
      "eol": false,
      "eol_note": null,
      "update_hint": "Open Firefox, go to Settings > General > Firefox Updates, click Check for updates, then Restart to update.",
      "source_url": "https://www.mozilla.org/en-US/security/known-vulnerabilities/firefox/"
    },
    {
      "id": "acrobat-reader",
      "display_name": "Adobe Acrobat Reader",
      "match": { "name_regex": "^Adobe Acrobat Reader( DC)?( .*)?$", "publisher_regex": "^Adobe" },
      "min_safe_version": "25.001.20937",
      "severity": "high",
      "eol": false,
      "eol_note": null,
      "update_hint": "Open Acrobat Reader, choose Menu > Help > Check for updates, and install what it finds.",
      "source_url": "https://helpx.adobe.com/security/products/acrobat.html"
    },
    {
      "id": "7zip",
      "display_name": "7-Zip",
      "match": { "name_regex": "^7-Zip( [0-9][0-9.]*)?( \\((x64|x86|arm64)( edition)?\\))?$", "publisher_regex": "^Igor Pavlov" },
      "min_safe_version": "25.00",
      "severity": "high",
      "eol": false,
      "eol_note": null,
      "update_hint": "7-Zip does not update itself: download the latest installer from 7-zip.org and run it over the old version.",
      "source_url": "https://www.7-zip.org/history.txt"
    },
    {
      "id": "winrar",
      "display_name": "WinRAR",
      "match": { "name_regex": "^WinRAR( [0-9][0-9.]*)?( \\((32|64)-bit\\))?$", "publisher_regex": "^win\\.rar" },
      "min_safe_version": "7.13",
      "severity": "high",
      "eol": false,
      "eol_note": null,
      "update_hint": "WinRAR does not update itself: download the latest version from win-rar.com and install it over the old one.",
      "source_url": "https://www.win-rar.com/whatsnew.html"
    },
    {
      "id": "zoom",
      "display_name": "Zoom",
      "match": { "name_regex": "^Zoom( Workplace)?( \\((32|64)-bit\\))?$", "publisher_regex": "^Zoom" },
